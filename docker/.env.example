############
# Gubernator self-hosted deploy configuration.
#
# Quick start:
#   1. cp .env.example .env
#   2. sh generate-keys.sh --update-env   (fills every secret below)
#   3. Edit the URLs + SMTP sections for your domain/provider
#   4. docker compose up -d --build
############

############
# Secrets — all filled by generate-keys.sh, never commit .env
############

POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Symmetric HS256 JWT signing key shared by auth, rest, realtime, storage, functions
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# HS256-signed API key JWTs (role: anon / service_role) derived from JWT_SECRET
ANON_KEY=replace-me
SERVICE_ROLE_KEY=replace-me

# Supabase Studio dashboard login (served on KONG_HTTP_PORT)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Realtime encryption (>= 64 chars / exactly 16 chars)
SECRET_KEY_BASE=replace-me-with-64-plus-characters
REALTIME_DB_ENC_KEY=supabaserealtime

# Studio <-> postgres-meta connection string encryption (>= 32 chars)
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Storage S3-protocol endpoint credentials
S3_PROTOCOL_ACCESS_KEY_ID=replace-me
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-me

############
# URLs — set these to your real domain(s)
############

# Public URL of the Supabase API gateway (Kong). The React app is built
# against this value (VITE_SUPABASE_URL), so browsers must be able to reach it.
SUPABASE_PUBLIC_URL=http://localhost:8000

# External URL of the Auth service (normally identical to SUPABASE_PUBLIC_URL).
# Used in magic-link emails and OAuth callbacks.
API_EXTERNAL_URL=http://localhost:8000

# Public URL of the React app — magic links redirect here after verification.
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

############
# Ports
############

# React app (nginx)
APP_PORT=3000
# Supabase API gateway + Studio dashboard
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
# Postgres — published on 127.0.0.1 only (server-local admin access)
POSTGRES_PORT=5432

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres

# Apply supabase/seed.sql (deterministic test users + worlds) after migrations.
# Leave false in production; set true only for throwaway/dev stacks.
APPLY_SEED=false

############
# Auth
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

############
# SMTP — required for magic-link sign-in (SendGrid, Postmark, Resend, ...)
############

SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Gubernator

############
# Edge functions
############

# Functions validate JWT + roles themselves; keep gateway verification off
# so CORS preflight (no Authorization header) is not rejected.
FUNCTIONS_VERIFY_JWT=false

# Per-function CORS origin allowlists. Comma-separated origins,
# scheme + host only, no path, no trailing slash. Must include the
# public origin of the React app (SITE_URL) or browsers get HTTP 403.
END_TURN_SIMULATION_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_CREATE_USER_ALLOWED_ORIGINS=http://localhost:3000
EXPORT_WORLD_TEMPLATE_ALLOWED_ORIGINS=http://localhost:3000

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Gubernator
STUDIO_DEFAULT_PROJECT=Gubernator
# Optional: enables Studio AI assistant
OPENAI_API_KEY=

############
# Storage
############

# Directory name for the 'file' storage backend
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true
