VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SMTP Configuration for magic-link email delivery and the send-email Edge
# Function (superadmin test/notification sends).
# For local development, use Inbucket. Inbucket's SMTP port (1025) is only
# reachable over the Docker network via its "inbucket" service alias -- not
# localhost:54324, which is Inbucket's *web UI* port mapped to the host.
SUPABASE_SMTP_HOST=inbucket
SUPABASE_SMTP_PORT=1025
# Optional: leave empty for Inbucket (no auth required)
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
# Admin email sender address (shown as "From" in sent emails)
SUPABASE_SMTP_ADMIN_EMAIL=noreply@gubernator.local
# Human-friendly sender name
SUPABASE_SMTP_SENDER_NAME=Gubernator

# Supabase Edge Function CORS Allowlist
# These env vars are read by Edge Functions to enforce per-function CORS origin validation.
# Unlike Vite env vars (VITE_*), these are Supabase secrets configured in supabase/config.toml
# for local dev and must be set as environment secrets for staging/production deployments.
# Requests from origins not in the allowlist receive HTTP 403. Both vars are comma-separated
# origin lists (scheme + host, no path, no trailing slash — e.g. "https://app.example.com").
#
# For local development, use the Vite dev server origins:
# END_TURN_SIMULATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ADMIN_CREATE_USER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SEND_EMAIL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
